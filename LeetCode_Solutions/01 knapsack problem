class Solution {
    public int knapsack(int W, int val[], int wt[]) {
        int n=val.length;
        int[][] dp=new int[n+1][W+1];
        
        for(int i=n-1;i>=0;i--){
            for(int cap=0;cap<=W;cap++){
                if(wt[i]>cap){
                    dp[i][cap]=dp[i+1][cap];
                }else{
                    dp[i][cap]=Math.max(dp[i+1][cap],val[i]+(dp[i+1][cap-wt[i]]));
                }
            }
        }
        return dp[0][W];
    }
}
